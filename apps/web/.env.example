# URL internal NestJS. Tidak menggunakan NEXT_PUBLIC agar tetap server-only.
API_URL=http://127.0.0.1:3001
# Opsional untuk pengembangan real-time di masa mendatang.
# NEXT_PUBLIC_WEBSOCKET_URL=

# Google Maps untuk memilih titik lokasi aset.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Opsional: gunakan map ID sendiri; default untuk pengembangan adalah DEMO_MAP_ID.
# NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
